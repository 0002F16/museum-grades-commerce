# ── Postgres connection ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Standard Postgres connection string.
# On your VPS: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://myuser:mypassword@123.456.789.0:5432/museum_grades"

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"
# The canonical URL of your app (used by Better Auth for redirects)
BETTER_AUTH_URL="https://your-domain.com"

# ── Admin dashboard ───────────────────────────────────────────────────────────
# Standalone gate for /admin (separate from customer accounts).
# Generate ADMIN_SECRET with: openssl rand -base64 32
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SECRET="your-admin-signing-secret"

# ── Transactional email (Resend) ──────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"
# Verified sender. Requires verifying museumgrades.com in Resend (DKIM/SPF DNS).
# Until verified, use "Museum Grades <onboarding@resend.dev>" for testing.
EMAIL_FROM="Museum Grades <hello@museumgrades.com>"
# Where new-order alerts are sent (the shop owner).
ORDER_NOTIFICATION_EMAIL="hr.museumestates@gmail.com"
