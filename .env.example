# ── Postgres connection ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Standard Postgres connection string.
# On your VPS: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://myuser:mypassword@123.456.789.0:5432/museum_grades"

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"
# The canonical URL of your app (used by Better Auth for redirects)
BETTER_AUTH_URL="https://your-domain.com"
